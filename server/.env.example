PORT=5000
NODE_ENV=development

MONGO_URI=mongodb://localhost:27017/waste_mgmt

JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

GMAIL_CLIENT_ID=your_google_oauth_client_id
GMAIL_CLIENT_SECRET=your_google_oauth_client_secret
GMAIL_REDIRECT_URI=https://developers.google.com/oauthplayground
GMAIL_REFRESH_TOKEN=your_refresh_token
GMAIL_SENDER_EMAIL=your_gmail_address@gmail.com

CLIENT_URL=http://localhost:5173

SLA_HOURS=48

# Set to "false" to skip sending real emails everywhere (submission/status/SLA digest) -
# useful when you don't have working Gmail OAuth credentials. Anything else sends normally.
EMAIL_ENABLED=true #false

# Set to "db" to store uploaded photos as a base64 data URI directly on the Complaint
# document instead of uploading to Cloudinary - useful when you don't have Cloudinary
# credentials. Anything else (or unset) uses Cloudinary as before.
IMAGE_STORAGE=cloudinary #DB

# Max size (in MB) accepted for complaint/resolution photo uploads. Requests over this
# are rejected with a 400 before the file is processed. Defaults to 5 if unset.
MAX_IMAGE_SIZE_MB=5